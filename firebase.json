{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/driver/mode-select.html",
        "destination": "/driver/driver.html",
        "type": 301
      },
      {
        "source": "/driver/transport.html",
        "destination": "/driver/driver.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}